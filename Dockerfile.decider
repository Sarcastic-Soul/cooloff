# Decider 2B server image. One Dockerfile, two builds:
#   docker build --build-arg TORCH=cpu -f Dockerfile.decider .   (CPU only, small)
#   docker build --build-arg TORCH=gpu -f Dockerfile.decider .   (NVIDIA GPU, driver 525+; torch brings its own CUDA libs)
FROM python:3.12-slim

ARG TORCH=cpu
# CUDA 12.6 wheels run on NVIDIA drivers 525 and newer. Plain PyPI torch is now built for CUDA 13,
# which needs driver 580 or newer, so we pin the older build to work on more laptops.
ARG CUDA_INDEX=https://download.pytorch.org/whl/cu126
# strands-decider from GitHub, pinned. The PyPI release (0.1.0) is older: it has no cpu_kernels.py (faster CPU
# conv) and no `cuda` extra (flash-linear-attention Triton kernels, which the GPU path needs for speed).
ARG DECIDER_REF=6039cf8b64c6074e75804000c07ac3d4cce795f7

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf

# gcc: the GPU path compiles small Triton helper code at first use and fails without a C compiler
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

# torch first, so the right build is chosen before strands-decider pulls its own
RUN if [ "$TORCH" = "cpu" ]; then \
      uv pip install torch --index-url https://download.pytorch.org/whl/cpu; \
    else \
      uv pip install torch --index-url "$CUDA_INDEX"; \
    fi

RUN if [ "$TORCH" = "gpu" ]; then EXTRA="[cuda]"; else EXTRA=""; fi; \
    uv pip install "strands-decider${EXTRA} @ git+https://github.com/strands-labs/strands-decider@${DECIDER_REF}"

WORKDIR /app
COPY scripts/smoke.py scripts/score_sentences.py /app/

EXPOSE 8000
CMD ["sh", "-c", "strands-decider serve ${DECIDER_MODEL} --port 8000 --device ${DECIDER_DEVICE}"]
